<UserControl x:Class="FlutterSDKInstaller.Controls.WizardFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlutterSDKInstaller.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Height="50">
    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Margin="0,0,16,0">

            <!-- 戻るボタン -->
            <Button x:Name="BackButton" 
                    Content="戻る" 
                    Width="80" Height="26" 
                    Margin="0,0,8,0" 
                    Click="BackButton_Click" Style="{StaticResource RoundedButton}"/>

            <!-- 次へボタン -->
            <Button x:Name="NextButton" 
                    Content="次へ" 
                    Width="80" Height="26" 
                    Margin="0,0,8,0" 
                    Click="NextButton_Click" Style="{StaticResource RoundedButton}"/>

            <!-- キャンセルボタン -->
            <Button x:Name="CancelButton" 
                    Content="キャンセル" 
                    Width="80" Height="26" 
                    Click="CancelButton_Click" Style="{StaticResource RoundedButton}"/>

        </StackPanel>
    </Grid>
</UserControl>
