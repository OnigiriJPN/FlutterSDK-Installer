<Page x:Class="FlutterSDKInstaller.Pages.Step4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FlutterSDKInstaller.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Step4Page">

    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="セットアップが完了しました" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="Green"
                       Margin="0,0,0,12"/>
            <TextBlock Text="Flutter SDKのインストールが正常に終了しました。" 
                       FontSize="14" 
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <TextBlock Text="「完了」をクリックしてウィザードを終了してください。" 
                       FontSize="12" 
                       Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Page>
