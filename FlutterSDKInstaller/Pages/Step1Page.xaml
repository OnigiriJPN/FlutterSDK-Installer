<Page x:Class="FlutterSDKInstaller.Pages.Step1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FlutterSDKInstaller.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Step1Page">

    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Flutter SDK インストーラーへようこそ" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Margin="0,0,0,12"/>
            <TextBlock Text="このウィザードでは、お使いの環境にFlutter SDKを簡単かつ綺麗にセットアップします。" 
                       FontSize="14" 
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <TextBlock Text="「次へ」をクリックして進んでください。" 
                       FontSize="12" 
                       Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Page>
