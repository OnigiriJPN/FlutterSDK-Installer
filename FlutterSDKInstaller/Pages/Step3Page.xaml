<Page x:Class="FlutterSDKInstaller.Pages.Step3Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FlutterSDKInstaller.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Step3Page">

    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="インストールを実行中..." 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,16"/>
            <TextBlock x:Name="StatusText" 
                       Text="SDKファイルをダウンロード・展開しています..." 
                       FontSize="13" 
                       Margin="0,0,0,12"/>

            <!-- プログレスバー -->
            <ProgressBar Height="20" IsIndeterminate="True" Margin="0,0,0,8"/>
        </StackPanel>
    </Grid>
</Page>
